<mvc:View controllerName="chatbotfrontend.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <List id="messageList" items="{/AIMessage}">
                <StandardListItem title="{question}" />
            </List>
            <Input id="messageInput" placeholder="Type your message..." />
            <Button text="Send" press="onSendMessage" />
            <IconTabBar id="tabBar" select="onTabSelect" expandable="false">
                <items>
                    <IconTabFilter id="inboxTab" key="inbox" text="Inbox" />
                    <IconTabFilter id="sentTab" key="sent" text="Sent" />
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
